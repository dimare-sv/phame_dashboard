# ── 로그인 (Google Workspace) ────────────────────────────────
# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 세션 서명 키. 아무 난수나 되고, `npx auth secret` 로 뽑아도 된다.
# 운영에서 이 값이 없으면 앱이 뜨지 않는다 (열리는 것보다 막히는 게 맞다).
AUTH_SECRET=

# 이 도메인 계정만 들어올 수 있다. 비워두면 도메인 제한 없이 아무 구글
# 계정이나 로그인 가능 — 회사가 Google Workspace 로 전환되면 채울 것.
ALLOWED_EMAIL_DOMAIN=

# 배포 주소. Vercel 에서는 자동으로 잡히므로 보통 비워둔다.
# AUTH_URL=https://pharme-dashboard.vercel.app

# ── 데이터 소스 ──────────────────────────────────────────────
# 현재 구현된 값은 mock 뿐이다.
# ga4 / db 어댑터가 추가되면 여기만 바꾸면 화면은 그대로 동작한다.
DATA_SOURCE=mock

# --- GA4 어댑터용 (아직 미구현) ---
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- DB 어댑터용 (아직 미구현) ---
# DATABASE_URL=
